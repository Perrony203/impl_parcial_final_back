# ==============================================
# BadPlan Microservices - Docker Environment
# ==============================================
# Copy this file to .env and update with your actual values

# ==============================================
# DATABASE CREDENTIALS - User Service
# ==============================================
DB_USERNAME_USERS=user_admin
DB_PASSWORD_USERS=user_password
DB_DATABASE_USERS=badplan_users

# ==============================================
# DATABASE CREDENTIALS - Resistance Service
# ==============================================
DB_USERNAME_RESISTANCE=resistance_admin
DB_PASSWORD_RESISTANCE=resistance_password
DB_DATABASE_RESISTANCE=badplan_resistance

# ==============================================
# JWT SECRET (SHARED ACROSS ALL SERVICES)
# ==============================================
# IMPORTANT: Change this to a strong random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ==============================================
# EUREKA SERVER CONFIGURATION
# ==============================================
EUREKA_HOST=eureka
EUREKA_PORT=8761

# ==============================================
# SERVICE PORTS (for reference, configured in docker-compose.yml)
# ==============================================
# Eureka Server: 8761
# Gateway Service: 3000
# User Service: 3001
# Resistance Service: 3002
# PostgreSQL Users: 5433 (external) -> 5432 (internal)
# PostgreSQL Resistance: 5434 (external) -> 5432 (internal)

# ==============================================
# NOTES FOR PRODUCTION
# ==============================================
# 1. Generate a strong JWT_SECRET using: openssl rand -base64 64
# 2. Use strong database passwords
# 3. Never commit the actual .env file to version control
# 4. Consider using Docker Secrets for sensitive data in production
