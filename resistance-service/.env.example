PORT=3002

# Database Configuration
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=resistance_admin
DB_PASSWORD=resistance_password
DB_DATABASE=badplan_resistance
DB_DIALECT=postgres

# JWT Configuration (must match gateway and other services)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Eureka Service Discovery
EUREKA_HOST=localhost
EUREKA_PORT=8761

# User Service (for inter-service communication)
USER_SERVICE_NAME=USER-SERVICE
